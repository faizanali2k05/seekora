SEEKORA_ENV=development
SEEKORA_DATABASE_URL=postgresql+psycopg://seekora:seekora@postgres:5432/seekora
SEEKORA_REDIS_URL=redis://redis:6379/0
SEEKORA_CORS_ORIGINS=http://localhost:3000
SEEKORA_CRAWLER_USER_AGENT=SeekoraBot/0.1 (+http://localhost:3000/about)
SEEKORA_CRAWL_MIN_DELAY_SECONDS=1.0
SEEKORA_CRAWL_TIMEOUT_SECONDS=12.0
SEEKORA_MAX_RESPONSE_BYTES=5000000
SEEKORA_MAX_DOCUMENT_CHARACTERS=500000
SEEKORA_LOG_LEVEL=INFO
SEEKORA_ADMIN_API_KEY=replace-with-a-long-random-secret
SEEKORA_RATE_LIMIT_ENABLED=true
SEEKORA_RATE_LIMIT_REQUESTS=120
SEEKORA_RATE_LIMIT_WINDOW_SECONDS=60
SEEKORA_DEMO_MODE=false
SEEKORA_RAG_PROVIDER=extractive
SEEKORA_RAG_MODEL=local-extractive-v1
SEEKORA_RAG_BASE_URL=https://api.openai.com/v1
# SEEKORA_RAG_API_KEY=optional-only-for-openai-compatible-provider
SEEKORA_ANSWER_MAX_SOURCES=4
NEXT_PUBLIC_API_URL=http://localhost:8000
